{
  "name": "smashrun-mcp",
  "version": "1.0.1",
  "description": "MCP server for retrieving a user's running data from Smashrun",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "smashrun-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elbonian/smashrun-mcp.git"
  },
  "homepage": "https://github.com/elbonian/smashrun-mcp#readme",
  "bugs": {
    "url": "https://github.com/elbonian/smashrun-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "smashrun",
    "running",
    "model-context-protocol"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
